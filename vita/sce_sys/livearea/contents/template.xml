<?xml version="1.0" encoding="utf-8"?>
<!-- Style a5: the gate (the heart) starts the app as usual; the right column's first two frames are
     slim launchers that open the Google Drive vault and the vault on the card straight away (the app
     reads the param); frame7, under the heart, shows the vault's numbers, which the app writes there
     (src/livearea.c). The pictures: tools/make-livearea.mjs. -->
<livearea style="a5" format-ver="01.00" content-rev="3">
  <livearea-background>
    <image>bg.png</image>
  </livearea-background>
  <gate>
    <startup-image>startup.png</startup-image>
  </gate>
  <frame id="frame1">
    <liveitem>
      <image>drive.png</image>
      <target>psgm:play?titleid=LWDV00001&amp;param=drive</target>
    </liveitem>
  </frame>
  <frame id="frame2">
    <liveitem>
      <image>local.png</image>
      <target>psgm:play?titleid=LWDV00001&amp;param=local</target>
    </liveitem>
  </frame>
  <frame id="frame7">
    <liveitem>
      <background>stats.png</background>
      <text valign="center" align="left" text-align="left" text-valign="center" word-wrap="on" ellipsis="on" x="40" width="290">
        <str size="20" color="#fff5f8" shadow="on">Library · Browser · Videos · Slideshow · Google Drive · Wi-Fi transfer</str>
      </text>
    </liveitem>
  </frame>
</livearea>
