{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lewd Vault",
  "version": "1.1.0",
  "identifier": "local.imagevault.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lewd Vault",
        "create": false,
        "dragDropEnabled": false,
        "width": 1400,
        "height": 900,
        "minWidth": 560,
        "minHeight": 420,
        "decorations": false,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "26.0"
    }
  }
}
